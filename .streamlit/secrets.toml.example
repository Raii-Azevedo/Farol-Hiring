# =====================================================================
# MODELO — copie para .streamlit/secrets.toml e preencha.
#
# Este arquivo (.example) VAI para o Git. O secrets.toml NÃO vai: está
# no .gitignore, e é nele que ficam os segredos de verdade.
# Nunca cole uma chave de service account em commit, PR, issue ou print.
#
# Quem preenche o quê:
#   [gcp_service_account] -> depende do time de Dados: eles criam a
#                            conta e mandam a chave JSON por canal privado.
#   [auth]                -> quem administra o projeto Google da Artefact:
#                            cria o cliente OAuth.
#
# Os dois blocos são independentes. Sem [auth] o app roda em modo aberto
# (sem login), com o BigQuery funcionando normalmente.
# =====================================================================


# ---------------------------------------------------------------------
# 1. BIGQUERY — de onde o Farol lê os dados
#
# O app lê sempre das views br-in-dataplatform.greenhouse_dev.vw_farol_base
# e .vw_farol_demanda. Não existe modo CSV.
#
# Ele procura credencial nesta ordem:
#   1. o bloco abaixo — é o que funciona em servidor, onde não há gcloud;
#   2. se o bloco não existir: a credencial da própria máquina, criada
#      com `gcloud auth application-default login`.
#
# PARA O TIME DE DADOS — a service account precisa de duas roles:
#   roles/bigquery.dataViewer  no dataset greenhouse_dev
#   roles/bigquery.jobUser     no projeto br-in-dataplatform
#
# O jobUser é o que mais passa batido. Sem ele a conta ENXERGA as views
# mas não consegue EXECUTAR a query, e o erro que volta fala de permissão
# de job — parece outro problema.
#
# É leitura apenas: a conta não precisa de acesso a mais nada.
#
# Cole o JSON da chave campo por campo e descomente o bloco:
# ---------------------------------------------------------------------
# [gcp_service_account]
# type                        = "service_account"
# project_id                  = "br-in-dataplatform"
# private_key_id              = "..."
# private_key                 = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email                = "farol@br-in-dataplatform.iam.gserviceaccount.com"
# client_id                   = "..."
# auth_uri                    = "https://accounts.google.com/o/oauth2/auth"
# token_uri                   = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url        = "..."
#
# A private_key fica em UMA linha só, com os \n literais como vieram no
# JSON — não quebre a linha de verdade, senão a chave não é lida.


# ---------------------------------------------------------------------
# 2. LOGIN COM GOOGLE — quem pode abrir o Farol
#
# ATENÇÃO: deixe este bloco COMENTADO até ter client_id e client_secret
# reais. O app considera o login configurado assim que encontra um
# client_id, qualquer que seja o valor — com o exemplo abaixo ativo ele
# tenta logar e falha no Google. Comentado, roda em modo aberto, com
# aviso visível na tela.
#
# Como gerar, em https://console.cloud.google.com/auth/overview :
#   1. Selecione (ou crie) o projeto da Artefact.
#   2. "Branding": preencha o consent screen (nome do app, domínio).
#   3. "Audience": em ambiente de teste, adicione os e-mails que vão logar.
#   4. "Clients" -> "CREATE CLIENT" -> tipo "Web application".
#      Em "Authorized redirect URIs", a URL do app + /oauth2callback
#      (local: http://localhost:8501/oauth2callback).
#   5. Copie o Client ID e o Client secret para os campos abaixo.
#
# cookie_secret: string aleatória forte (`openssl rand -hex 32`).
# Guia: https://docs.streamlit.io/develop/tutorials/authentication/google
#
# Login e permissão são coisas diferentes: o OAuth prova QUEM é a pessoa,
# e o authorized_users.csv (com active = true) diz se ela pode ver.
# ---------------------------------------------------------------------
# [auth]
# redirect_uri        = "http://localhost:8501/oauth2callback"
# cookie_secret       = "troque-por-um-segredo-aleatorio-forte"
# client_id           = "xxx.apps.googleusercontent.com"
# client_secret       = "xxx"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
